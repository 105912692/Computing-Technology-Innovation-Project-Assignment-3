# Copy to .env (never commit .env)

# The front end allowed to call this API from a browser (CORS). Vite's dev server by default.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Use a dedicated app user (not the postgres superuser). Put the real password only in .env.
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/phishing

# Signs login tokens. Use a long random value (at least 32 characters), different on every machine. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_value_of_at_least_32_characters

# Only for the automated tests (pytest). MUST be a different database: every test deletes all its data.
TEST_DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/phishing_test
