# Copy to .env.local. Only variables starting with VITE_ reach the browser code.
#
# Leave VITE_API_URL empty in development: the Vite dev server forwards /api/* to
# http://127.0.0.1:8000 (see vite.config.js).
# For a build that talks to a deployed back end, set its address, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=
