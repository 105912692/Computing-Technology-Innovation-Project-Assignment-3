# ---------------------------------------------------------------------------
# COS30049 Assignment 3 - one .gitignore for the whole repo
# Keep: source code, models/*.joblib (the brief says include the model file),
#       .env.example files, package-lock.json, requirements.txt
# ---------------------------------------------------------------------------

# --- Secrets (copy the .env.example files instead) ---
.env
.env.*
!.env.example
*.local
*.pem
*.key

# --- Python (back end) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node / Vite (front end) ---
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local data and test output ---
*.log
*.db
*.sqlite3
uploads/
zap-report*
pip-audit-report*

# --- Editors and operating systems ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
